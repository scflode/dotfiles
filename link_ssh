#!/usr/bin/env bash

set -euo pipefail

source_dir="$HOME/Nextcloud/Private/ssh"
target="$HOME/.ssh"

[[ -d $source_dir ]] || { echo "Nextcloud SSH directory is not synced: $source_dir" >&2; exit 1; }
if [[ -e $target || -L $target ]]; then
  [[ -L $target && $(readlink "$target") == "$source_dir" ]] || {
    echo "Refusing to replace existing $target; back it up or migrate it first." >&2
    exit 1
  }
else
  ln -s "$source_dir" "$target"
fi

find "$source_dir" -type d -exec chmod 700 {} +
find "$source_dir" -type f -name '*.pub' -exec chmod 644 {} +
find "$source_dir" -type f ! -name '*.pub' -exec chmod 600 {} +
