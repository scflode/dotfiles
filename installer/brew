#!/usr/bin/env bash

set -euo pipefail

stage=${1:-bootstrap}
root_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)

brew_bin=$(command -v brew || true)
if [[ -z $brew_bin ]]; then
  for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    [[ -x $candidate ]] && brew_bin=$candidate && break
  done
fi
if [[ -z $brew_bin ]]; then
  [[ $stage == bootstrap ]] || { echo "Run ./setup bootstrap first." >&2; exit 1; }
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    [[ -x $candidate ]] && brew_bin=$candidate && break
  done
fi
[[ -n $brew_bin ]] || { echo "Homebrew installation failed." >&2; exit 1; }
eval "$("$brew_bin" shellenv)"
shellenv="eval \"\$($brew_bin shellenv)\""
grep -qxF "$shellenv" "$HOME/.zprofile" 2>/dev/null || echo "$shellenv" >> "$HOME/.zprofile"

case $stage in
  bootstrap) brew bundle install --file "$root_dir/Brewfile" ;;
  apps)
    brew tap munichmade/tap
    brew trust --cask munichmade/tap/devproxy
    # brew bundle 6 fetches mixed casks as formulae; install its parsed cask list directly.
    while IFS= read -r cask; do
      brew install --cask "$cask"
    done < <(brew bundle list --file "$root_dir/Brewfile.apps" --cask)
    ;;
  store) brew bundle install --file "$root_dir/Brewfile.mas" ;;
  *) echo "Unknown Homebrew stage: $stage" >&2; exit 1 ;;
esac
