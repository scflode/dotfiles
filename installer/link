#!/usr/bin/env bash

dot_dir="${HOME}/.dotfiles"

echo -e "Linking dotfiles"

echo -e "\tLinking Vim config"
mkdir -p ~/.vim
mkdir -p ~/.config/nvim
rcup config/nvim/init.lua
rcup config/nvim/lua

echo -e "\tLinking Kitty config"
rcup config/kitty/kitty.conf

echo -e "\tLinking Ghostty config"
mkdir -p ~/.config/ghostty
rcup config/ghostty/config

echo -e "\tLinking tmux config"
rcup tmux.conf


echo -e "\tLinking Zellij config"
mkdir -p ~/.config/zellij
rcup config/zellij/config.kdl
rcup config/zellij/layouts

echo -e "\tLinking Git config"
rcup gitconfig
rcup gitignore_global

echo -e "\tLinking Pi custom extensions"
mkdir -p ~/.pi/agent/extensions/pi-rtk-optimizer
ln -sfn "${dot_dir}/pi/agent/extensions/danger-guard.ts" ~/.pi/agent/extensions/danger-guard.ts
ln -sfn "${dot_dir}/pi/agent/extensions/ghostty-context-notify.ts" ~/.pi/agent/extensions/ghostty-context-notify.ts
ln -sfn "${dot_dir}/pi/agent/extensions/session-name-status.ts" ~/.pi/agent/extensions/session-name-status.ts
ln -sfn "${dot_dir}/pi/agent/extensions/pi-rtk-optimizer/config.json" ~/.pi/agent/extensions/pi-rtk-optimizer/config.json

echo -e "\tLinking Mise config"
mkdir -p ~/.config/mise
rcup config/mise/config.toml
