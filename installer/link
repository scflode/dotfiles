#!/usr/bin/env bash

set -euo pipefail

root_dir=${DOTFILES_DIR:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)}
command -v rcup >/dev/null || { echo "rcm missing; Homebrew phase failed." >&2; exit 1; }
link() { rcup -d "$root_dir" "$1"; }

echo "Linking dotfiles"

link config/LazyVim
link config/ghostty/config
link config/tmux
link tmux.conf
link gitconfig
link gitignore_global
link zsh_plugins.txt
link config/mise/config.toml

mkdir -p "$HOME/.pi/agent/extensions/pi-rtk-optimizer"
ln -sfn "$root_dir/pi/agent/extensions/danger-guard.ts" "$HOME/.pi/agent/extensions/danger-guard.ts"
ln -sfn "$root_dir/pi/agent/extensions/ghostty-context-notify.ts" "$HOME/.pi/agent/extensions/ghostty-context-notify.ts"
ln -sfn "$root_dir/pi/agent/extensions/session-name-status.ts" "$HOME/.pi/agent/extensions/session-name-status.ts"
ln -sfn "$root_dir/pi/agent/extensions/pi-rtk-optimizer/config.json" "$HOME/.pi/agent/extensions/pi-rtk-optimizer/config.json"
