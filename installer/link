#!/usr/bin/env bash

set -euo pipefail

root_dir=${DOTFILES_DIR:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)}
command -v rcup >/dev/null || { echo "rcm missing; Homebrew phase failed." >&2; exit 1; }
link() { rcup -d "$root_dir" "$1"; }

echo "Linking dotfiles"

link config/LazyVim
link config/aerospace
link config/ghostty/config
link config/tmux
link config/zed
link tmux.conf
link gitconfig
link gitignore_global
link zsh_plugins.txt
link config/mise/config.toml

mkdir -p "$HOME/.agents/skills"
for skill in "$root_dir"/.agents/skills/*; do
  target="$HOME/.agents/skills/${skill##*/}"
  if [[ -e $target && ! -L $target ]]; then
    echo "Keeping existing skill: ${target##*/}" >&2
  else
    ln -sfn "$skill" "$target"
  fi
done

mkdir -p "$HOME/.pi/agent/extensions/pi-rtk-optimizer"
ln -sfn "$root_dir/pi/agent/extensions/danger-guard.ts" "$HOME/.pi/agent/extensions/danger-guard.ts"
ln -sfn "$root_dir/pi/agent/extensions/ghostty-context-notify.ts" "$HOME/.pi/agent/extensions/ghostty-context-notify.ts"
ln -sfn "$root_dir/pi/agent/extensions/session-name-status.ts" "$HOME/.pi/agent/extensions/session-name-status.ts"
ln -sfn "$root_dir/pi/agent/extensions/provider-confirm.ts" "$HOME/.pi/agent/extensions/provider-confirm.ts"
ln -sfn "$root_dir/pi/agent/extensions/pi-rtk-optimizer/config.json" "$HOME/.pi/agent/extensions/pi-rtk-optimizer/config.json"
ln -sfn "$root_dir/pi/agent/extensions/pi-quota-status" "$HOME/.pi/agent/extensions/pi-quota-status"
ln -sfn "$root_dir/pi/agent/extensions/workmux-status.ts" "$HOME/.pi/agent/extensions/workmux-status.ts"

# Existing MCP definitions may contain personal servers or secrets; never replace them.
if [[ ! -e "$HOME/.pi/agent/mcp-adapter.json" && ! -L "$HOME/.pi/agent/mcp-adapter.json" ]]; then
  ln -s "$root_dir/pi/agent/mcp-adapter.json" "$HOME/.pi/agent/mcp-adapter.json"
fi
