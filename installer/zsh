#!/usr/bin/env bash

set -euo pipefail

root_dir=${DOTFILES_DIR:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)}
legacy_mise_activation='eval "$($(which mise) activate zsh)"'
if [[ -f $HOME/.zshrc ]] && grep -qF "$legacy_mise_activation" "$HOME/.zshrc"; then
  sed -i '' '/which mise) activate zsh/d' "$HOME/.zshrc"
fi

if [[ ! -e $HOME/.zshrc ]]; then
  printf 'dot_dir=%q\n' "$root_dir" > "$HOME/.zshrc"
  cat >> "$HOME/.zshrc" <<'EOF'
for file in functions exports aliases aliases_macos aliases_personal zsh nvims; do
  [[ -f "$dot_dir/$file" ]] && source "$dot_dir/$file"
done
EOF
fi

if ! dscl . -read "/Users/$USER" UserShell 2>/dev/null | grep -qx 'UserShell: /bin/zsh'; then
  chsh -s /bin/zsh
fi
