#!/usr/bin/env bash
set -euo pipefail

vault=${1:-SSH Keys}
out=${2:-$HOME/.ssh}

command -v op >/dev/null || { echo 'op CLI required' >&2; exit 1; }
command -v jq >/dev/null || { echo 'jq required' >&2; exit 1; }

op vault list --format json |
  jq -e --arg vault "$vault" 'any(.[]; .name == $vault)' >/dev/null || {
    echo "Vault not available to op CLI: $vault" >&2
    exit 1
  }

mkdir -p "$out"
failed=0

while IFS=$'\t' read -r id title; do
  name=$(printf '%s' "$title" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9._-' '-')
  file="$out/${name%-}.pub"
  temp=$(mktemp "$out/.1password-ssh-key.XXXXXX")

  if ! op read --force --out-file "$temp" "op://$vault/$id/public key"; then
    rm -f "$temp"
    failed=1
    continue
  fi

  if [[ -e $file ]] && ! cmp -s "$temp" "$file"; then
    echo "Refusing to replace different key: $file" >&2
    rm -f "$temp"
    failed=1
    continue
  fi

  mv "$temp" "$file"
  echo "$title -> $file"
done < <(op item list --vault "$vault" --categories 'SSH Key' --format json | jq -r '.[] | [.id, .title] | @tsv')

exit "$failed"
