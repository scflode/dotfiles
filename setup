#!/usr/bin/env bash

set -euo pipefail

root_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
export DOTFILES_DIR="$root_dir"

if [[ $(uname -s) != Darwin ]]; then
  echo "macOS is required."
  exit 1
fi

if ! xcode-select -p >/dev/null 2>&1; then
  xcode-select --install || true
  echo "Install Xcode Command Line Tools, then run setup again."
  exit 1
fi

computer_name=$(scutil --get LocalHostName 2>/dev/null || hostname -s)
read -r -p "Computer name [$computer_name]: " choice
computer_name=${choice:-$computer_name}

read -r -p "Run setup for $computer_name? [y/N] " choice
[[ $choice =~ ^[Yy]$ ]] || exit 0

sudo -v

for installer in macos brew link zsh tmux mise; do
  "$root_dir/installer/$installer" "$computer_name"
done

echo "Setup complete. Restart apps or log out for macOS preference changes."
