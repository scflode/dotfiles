{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "disabled_providers": [
    "amazon-bedrock"
  ],
  "plugin": [
    // "@tarquinen/opencode-dcp@latest"
  ],
  "small_model": "github-copilot/gpt-5-mini",
  "agent": {
    "compaction": {
      "model": "github-copilot/gpt-5-mini"
    },
    "title": {
      "model": "github-copilot/gpt-5-mini"
    }
  },
  "mcp": {
    "linear": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://mcp.linear.app/sse"
      ],
      "environment": {},
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "{env:CONTEXT7_API_KEY}"
      ],
      "enabled": true
    },
    "cocoindex-code": {
      "type": "local",
      "command": [
        "cocoindex-code"
      ]
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--browserUrl=http://127.0.0.1:9222"
      ]
    }
  }
}
