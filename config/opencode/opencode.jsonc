{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "disabled_providers": [
    "amazon-bedrock"
  ],
  "agent": {
    "compaction": {
      "model": "openai/gpt-5.4-mini",
    },
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "{env:CONTEXT7_API_KEY}"
      ],
      "enabled": true
    },
    "cocoindex-code": {
      "type": "local",
      "command": [
        "cocoindex-code"
      ]
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--browserUrl=http://127.0.0.1:9222"
      ]
    }
  }
}
